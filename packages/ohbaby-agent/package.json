{
  "name": "ohbaby-agent",
  "version": "0.1.15",
  "description": "Backend runtime for ohbaby-agent",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/*.unit.test.d.ts",
    "!dist/**/*.unit.test.d.ts.map",
    "!dist/**/*.contract.test.d.ts",
    "!dist/**/*.contract.test.d.ts.map",
    "!dist/**/*.integration.test.d.ts",
    "!dist/**/*.integration.test.d.ts.map",
    "README.md",
    "dist/assets/*.wasm",
    "dist/assets/SHELL-GRAMMAR-LICENSES.txt"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:inspect": "tsx watch --inspect src/index.ts",
    "prompt:generate": "node scripts/generate-system-prompt-assets.mjs",
    "prompt:check": "node scripts/generate-system-prompt-assets.mjs --check",
    "build": "pnpm run prompt:check && pnpm run export-assets:check && rimraf dist && tsup && node scripts/copy-shell-assets.mjs && tsc -b --force",
    "typecheck": "tsc -b",
    "clean": "rimraf dist coverage",
    "export-assets:generate": "node scripts/generate-session-export-assets.mjs",
    "export-assets:check": "node scripts/generate-session-export-assets.mjs --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tavily/core": "^0.6.4",
    "@vscode/ripgrep": "1.18.0",
    "agent-base": "^7",
    "axios": "^1.7.7",
    "chalk": "^5.4.1",
    "diff": "8.0.2",
    "dotenv": "^16.4.7",
    "exa-js": "^2.0.12",
    "https-proxy-agent": "^7",
    "ohbaby-sdk": "workspace:*",
    "openai": "^7.13.0",
    "undici": "^7",
    "web-tree-sitter": "0.25.10",
    "yaml": "^2.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "jsdom": "^25.0.1",
    "marked": "^15.0.3",
    "tree-sitter-bash": "0.25.0",
    "tree-sitter-powershell": "0.25.10"
  }
}
