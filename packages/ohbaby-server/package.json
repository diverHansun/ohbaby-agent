{
  "name": "ohbaby-server",
  "version": "0.1.17",
  "description": "Explicit local server and remote client adapters for ohbaby",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/*.unit.test.d.ts",
    "!dist/**/*.unit.test.d.ts.map",
    "!dist/**/*.contract.test.d.ts",
    "!dist/**/*.contract.test.d.ts.map",
    "!dist/**/*.integration.test.d.ts",
    "!dist/**/*.integration.test.d.ts.map",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rimraf dist && tsup && tsc -b --force",
    "typecheck": "tsc -b",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.5",
    "@lydell/node-pty": "1.2.0-beta.18",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "hono": "^4.12.25",
    "ohbaby-agent": "workspace:*",
    "ohbaby-sdk": "workspace:*",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/ws": "8.18.2",
    "ohbaby-llm": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/diverHansun/ohbaby-agent.git",
    "directory": "packages/ohbaby-server"
  },
  "homepage": "https://github.com/diverHansun/ohbaby-agent#readme",
  "bugs": {
    "url": "https://github.com/diverHansun/ohbaby-agent/issues"
  },
  "license": "MIT"
}
