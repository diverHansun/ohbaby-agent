# Environment variables
# Copy this file to .env and fill in your values

# LLM provider key (optional for keyless local endpoints such as LM Studio)
ZAI_API_KEY=your_zhipu_api_key_here

# Web search provider key
TAVILY_API_KEY=your_tavily_api_key_here

# Local diagnostics (optional; defaults to info and ~/.ohbaby/logs)
# OHBABY_LOG_LEVEL=error|warn|info|debug|trace
# OHBABY_LOG_DIR=/absolute/path/to/private/logs
